{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.tsbuildinfo",
    // No JS source maps: the 64 KiB complete-dist gzip budget (#119) is effectively spent; maps added ~96 KiB raw with no consumer.
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../engine" }, { "path": "../ai" }]
}
